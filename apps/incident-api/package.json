{
  "name": "incident-quote-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:broken": "wrangler dev --config wrangler.broken.jsonc",
    "deploy:healthy": "wrangler deploy --config wrangler.jsonc",
    "deploy:broken": "wrangler deploy --config wrangler.broken.jsonc",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "wrangler types && tsc && node --test dist/index.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
